{
	"name": "AI",
	"subtitle": "App Installer",
	"description": "Allows to install apps from URL",
	"version": "1.3.0",
	"type": "privileged",
	"origin": "app://ai.io",
	"installs_allowed_from": ["*"],
	"size": 28023, "package_path": "https://schnark.github.io/ffosapp-installer/ffosapp-installer.zip",
	"icons": {
		"56": "/icon-56.png",
		"112": "/icon-112.png",
		"128": "/icon-128.png",
		"512": "/icon-512.png"
	},
	"developer": {
		"name": "Michael Müller",
		"url": "https://github.com/Schnark"
	},
	"categories": [
		"utilities"
	],
	"permissions": {
		"webapps-manage": {}
	},
	"ime_default_softkey_bar": true,
	"cursor": true,
	"default_locale": "en"
}
