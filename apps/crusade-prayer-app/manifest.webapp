{
  "name": "Crusade Prayer",
  "description": "Daily Crusade Prayers and Litanies",
  "version": "2.1.0",
  "launch_path": "/index.html",
  "theme": "#8e44ad",
  "theme_color": "#8e44ad",
  "background_color": "#f5f5f5",
  "fullscreen": "true",
  "icons": {
    "56": "/icons/icon56.png",
    "112": "/icons/icon112.png"
  },
  "developer": {
    "name": "KaiOS Developer",
    "url": "https://crusadeprayergroup.org"
  },
  "type": "privileged",
  "permissions": {
    "systemXHR": {
      "description": "Required to fetch prayers and schedules from the website"
    }
  },
  "locales": {
    "en-US": {
      "name": "Crusade Prayer",
      "description": "Daily Crusade Prayers and Litanies"
    }
  },
  "default_locale": "en-US",
  "cursor": false
}
