{
  "moduleNameMapper": {
    "^react$": "preact/compat",
    "^react-dom$": "preact/compat",
    "@/(.*)$": "<rootDir>/src/$1",
    "@/helper/(.*)$": "<rootDir>/src/helper/$1"
  },
  "moduleFileExtensions": ["js", "jsx"],
  "setupFiles": ["<rootDir>/src/setupTests.js"],
  "testPathIgnorePatterns": ["/node_modules/"],
  "transform": {
    "\\.(scss|css)$": "<rootDir>/node_modules/jest-css-modules",
    "^.+\\.jsx?$": "babel-jest",
    "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga|properties)$":
      "<rootDir>/test/__mocks__/fileTransformer.js"
  },
  "transformIgnorePatterns": [],
  "coverageDirectory": "<rootDir>/test/coverage/"
}
