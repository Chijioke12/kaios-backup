{
  "game": "Jetpack Blitz \u2014 KaiOS",
  "engine": "Phaser CE",
  "format": "WAV, 22050Hz, 16-bit, Mono",
  "note": "Convert to OGG for smaller size: ffmpeg -i input.wav -q:a 4 output.ogg",
  "files": {
    "sfx": {
      "jetpack_thrust": {
        "loop": true,
        "desc": "Play while jetpack firing. Loop seamlessly."
      },
      "coin_collect": {
        "loop": false,
        "desc": "Play on coin overlap."
      },
      "powerup_collect": {
        "loop": false,
        "desc": "Play on powerup pickup."
      },
      "missile_warning": {
        "loop": false,
        "desc": "Play when warning sign appears."
      },
      "explosion": {
        "loop": false,
        "desc": "Play on player death or missile hit."
      },
      "zapper_hit": {
        "loop": false,
        "desc": "Play on zapper/laser contact."
      },
      "laser_hum": {
        "loop": true,
        "desc": "Play while laser beam is active."
      },
      "shield_activate": {
        "loop": false,
        "desc": "Play when shield powerup collected."
      },
      "shield_break": {
        "loop": false,
        "desc": "Play when shield absorbs a hit."
      },
      "ui_click": {
        "loop": false,
        "desc": "Menu navigation / button press."
      },
      "scientist_yelp": {
        "loop": false,
        "desc": "Play when scientist scatters from player."
      },
      "game_over_sting": {
        "loop": false,
        "desc": "Play at moment of death."
      }
    },
    "music": {
      "music_menu": {
        "loop": true,
        "desc": "Menu screen background music."
      },
      "music_game": {
        "loop": true,
        "desc": "Gameplay loop. Seamless loop."
      },
      "music_gameover": {
        "loop": false,
        "desc": "Game over screen music."
      },
      "music_highscore": {
        "loop": false,
        "desc": "New high score fanfare."
      }
    }
  },
  "phaser_ce_load": [
    "game.load.audio('jetpack_thrust',  'audio/jetpack_thrust.wav');",
    "game.load.audio('coin_collect',    'audio/coin_collect.wav');",
    "game.load.audio('powerup_collect', 'audio/powerup_collect.wav');",
    "game.load.audio('missile_warning', 'audio/missile_warning.wav');",
    "game.load.audio('explosion',       'audio/explosion.wav');",
    "game.load.audio('zapper_hit',      'audio/zapper_hit.wav');",
    "game.load.audio('laser_hum',       'audio/laser_hum.wav');",
    "game.load.audio('shield_activate', 'audio/shield_activate.wav');",
    "game.load.audio('shield_break',    'audio/shield_break.wav');",
    "game.load.audio('ui_click',        'audio/ui_click.wav');",
    "game.load.audio('scientist_yelp',  'audio/scientist_yelp.wav');",
    "game.load.audio('game_over_sting', 'audio/game_over_sting.wav');",
    "game.load.audio('music_menu',      'audio/music_menu.wav');",
    "game.load.audio('music_game',      'audio/music_game.wav');",
    "game.load.audio('music_gameover',  'audio/music_gameover.wav');",
    "game.load.audio('music_highscore', 'audio/music_highscore.wav');"
  ],
  "phaser_ce_play": {
    "jetpack_thrust": "this.thrustSound = game.add.audio('jetpack_thrust'); this.thrustSound.loop = true;",
    "music_game": "this.bgMusic = game.add.audio('music_game'); this.bgMusic.loop = true; this.bgMusic.play();",
    "coin_collect": "game.add.audio('coin_collect').play();"
  }
}